coverage
/junit.xml

# Dependency directory
node_modules

# Generated by npm@5, but project currently uses Yarn
package-lock.json

# Directories generated by Next.js
.next

# Accessibility Verification Testing
.avt/

# Yarn — dependency artifacts must never be tracked at any depth.
# NOTE: !.yarn/plugins/ is required on v10, which commits two plugins.
# (#21671 removed that line from main, which ships none.)
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
**/.yarn/cache/
**/.yarn/unplugged/
**/.yarn/offline-mirror/
**/.yarn/build-state.yml
**/.yarn/install-state.gz
**/.yarn-offline-mirror/

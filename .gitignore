# Build folders
/build
packages/*/build/
packages/*/examples/*/build/
es
lib
dist
umd
css

# Netlify deploy folder
/demo/*
!/demo/index.html

# Config files
.npmrc

# Cache folders
.cache
.parcel-cache

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Certificates
*.crt
*.pem

# Editor
.DS_Store
*.swp
.idea
.vscode

# Coverage directory used by tools like istanbul, also includes default junit
